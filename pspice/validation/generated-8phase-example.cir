Constant On-Time Lab -- generated 8-phase fixed-window COT deck
* Generated by pspice/scripts/generate_multiphase.py.
* Educational behavioral architecture; not a commercial-controller model.
.INC "pspice/lib/BUCK_PHASE.lib"
.INC "pspice/lib/COT_ONESHOT.lib"
.INC "pspice/lib/COT_CONTROLLER.lib"
.PARAM VIN_DC=12 VREF_DC=5
.PARAM TPER=2u TON=833.333333n
VIN IN 0 {VIN_DC}
VREF REF 0 PWL(0 0 5u 0 6u {VREF_DC})
VRIPPLE RIPPLE 0 0
VILIM ILIM 0 6
XCMP OUT REF RIPPLE REQCOMMON COT_REQUEST PARAMS:
+ VLOGIC=5 VSOFT=2m VHYST=4m TDELAY=10n
VPERMIT1 PERMIT1 0 PULSE(1 0 175n 1n 1n 1.823u 2u)
VPERMIT2 PERMIT2 0 PULSE(0 1 250n 1n 1n 175n 2u)
VPERMIT3 PERMIT3 0 PULSE(0 1 500n 1n 1n 175n 2u)
VPERMIT4 PERMIT4 0 PULSE(0 1 750n 1n 1n 175n 2u)
VPERMIT5 PERMIT5 0 PULSE(0 1 1u 1n 1n 175n 2u)
VPERMIT6 PERMIT6 0 PULSE(0 1 1.25u 1n 1n 175n 2u)
VPERMIT7 PERMIT7 0 PULSE(0 1 1.5u 1n 1n 175n 2u)
VPERMIT8 PERMIT8 0 PULSE(0 1 1.75u 1n 1n 175n 2u)
* Windows serialize requests, but phase power pulses may overlap.
EREQ1 REQ1 0 VALUE={V(REQCOMMON)*V(PERMIT1)}
XCL1 IMON1 ILIM TRIP1 COT_CURRENT_LIMIT PARAMS: VLOGIC=5
XSHOT1 REQ1 TRIP1 GATE1 READY1 COT_ONESHOT PARAMS:
+ TON={TON} TOFFMIN=100n VLOGIC=5
XDRV1 GATE1 GH1 GL1 COMPLEMENTARY_DRIVER PARAMS:
+ VLOGIC=5 DEAD=20n
XPH1 IN OUT GH1 GL1 SW1 IMON1 BUCK_PHASE PARAMS:
+ LPH=1.86u DCR=11.05m RHS=15m RLS=8m
EREQ2 REQ2 0 VALUE={V(REQCOMMON)*V(PERMIT2)}
XCL2 IMON2 ILIM TRIP2 COT_CURRENT_LIMIT PARAMS: VLOGIC=5
XSHOT2 REQ2 TRIP2 GATE2 READY2 COT_ONESHOT PARAMS:
+ TON={TON} TOFFMIN=100n VLOGIC=5
XDRV2 GATE2 GH2 GL2 COMPLEMENTARY_DRIVER PARAMS:
+ VLOGIC=5 DEAD=20n
XPH2 IN OUT GH2 GL2 SW2 IMON2 BUCK_PHASE PARAMS:
