+ TON={TON} TOFFMIN=100n VLOGIC=5
XDRV8 GATE8 GH8 GL8 COMPLEMENTARY_DRIVER PARAMS:
+ VLOGIC=5 DEAD=20n
XPH8 IN OUT GH8 GL8 SW8 IMON8 BUCK_PHASE PARAMS:
+ LPH=2.14u DCR=8.95m RHS=15m RLS=8m
EISUM ISUM 0 VALUE={V(IMON1)+V(IMON2)+V(IMON3)+V(IMON4)+V(IMON5)+V(IMON6)+V(IMON7)+V(IMON8)}
RESR OUT NCAP 5m
COUT NCAP 0 470u IC=0
* Resistive equivalent draws the requested load at target VOUT
RLOAD OUT 0 312.5m
RBLEED OUT 0 100
.IC V(OUT)=0
.OPTIONS RELTOL=1m ABSTOL=10n VNTOL=1u ITL4=2500
.TRAN 5n 2m 0 5n
.MEAS TRAN VOUT_AVG AVG V(OUT) FROM=1.8m TO=2m
.MEAS TRAN ISUM_AVG AVG V(ISUM) FROM=1.8m TO=2m
.PROBE V(OUT) V(ISUM) V(IMON1) V(IMON2) V(IMON3) V(IMON4) V(IMON5) V(IMON6) V(IMON7) V(IMON8)
+ V(SW1) V(SW2) V(SW3) V(SW4) V(SW5) V(SW6) V(SW7) V(SW8)
+ V(GATE1) V(GATE2) V(GATE3) V(GATE4) V(GATE5) V(GATE6) V(GATE7) V(GATE8)
.END
